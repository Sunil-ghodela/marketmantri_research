# Zerodha Kite Connect credentials
# Get these from https://developers.kite.trade (create an app)
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Populated automatically by fetch_data.py --refresh after the daily login flow.
# Expires at end of each trading day; rerun --refresh to get a new one.
KITE_ACCESS_TOKEN=
